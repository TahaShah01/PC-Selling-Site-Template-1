<script>
var $window = $(window);
var wW = $(window).width();
var trigger_size = [481];
$window.resize(function() {
	trigger_size.forEach(function(size) {
		if (wW > size) {
			($window.width() <= size) ? location.reload(): "";
		} else {
			($window.width() > size) ? location.reload(): "";
		}
	});
});
if ($(window).width() < 1281) {
	$(".secondary_menu").removeClass("has-child");
} else {
	$(".secondary_menu").addClass("has-child");
}

let _popupWindow = $.cookie('popupWindow');

$(function() {
	if (!_popupWindow) {
		$('.cookies-popup').show();
	}
});

$('body').delegate('#cookies-button', 'click', function() {
	//useAjax('saveAgree','');
	$.cookie('popupWindow', '1', {
		expires: 30,
		path: '/',
		domain: 'gskill.com',
		secure: true
	});
	$(".cookies-popup").animate({
		opacity: 0,
	}, {
		duration: 50,
		complete: function() {
			$(this).css({
				display:'none'
			});
		}
	});
})
</script>
